{
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh repo delete *)",
      "Bash(wrangler *)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.claude/settings*.json)",
      "Write(.claude/settings*.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Read(**/.env*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(curl *)",
      "Bash(gh pr create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-rails.sh\""
          }
        ]
      }
    ]
  }
}
